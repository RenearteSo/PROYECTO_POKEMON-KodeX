<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #050a15;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.equipoController">
    <children>
        <MediaView fx:id="fondoVideo" preserveRatio="false" />

        <ImageView fx:id="botonPantalla" fitHeight="35.0" fitWidth="35.0" onMouseClicked="#gestionarPantalla" pickOnBounds="true" preserveRatio="true" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
            <effect>
                <DropShadow color="WHITE" radius="5.0" spread="0.7" />
            </effect>
        </ImageView>

        <HBox alignment="CENTER" spacing="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button fx:id="btnCajaAnterior" mnemonicParsing="false" onAction="#accionCajaAnterior" style="-fx-font-family: 'Pokemon GB'; -fx-background-color: rgba(20,30,60,0.8); -fx-text-fill: white; -fx-border-color: #88aaff; -fx-border-radius: 3;" text="&lt;" />
                                <Label fx:id="lblNombreCaja" style="-fx-font-family: 'Pokemon GB'; -fx-text-fill: white;" text="CAJA 1">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Button fx:id="btnCajaSiguiente" mnemonicParsing="false" onAction="#accionCajaSiguiente" style="-fx-font-family: 'Pokemon GB'; -fx-background-color: rgba(20,30,60,0.8); -fx-text-fill: white; -fx-border-color: #88aaff; -fx-border-radius: 3;" text="&gt;" />
                            </children>
                        </HBox>
                        <GridPane fx:id="gridCaja" prefHeight="350.0" prefWidth="450.0" style="-fx-background-color: rgba(10, 15, 35, 0.8); -fx-background-radius: 10; -fx-border-color: #88aaff; -fx-border-radius: 10;">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </GridPane>
                    </children>
                </VBox>

                <VBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="btnMoverEquipo" mnemonicParsing="false" onAction="#accionMoverAEquipo" prefHeight="45.0" prefWidth="160.0" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10; -fx-background-color: rgba(20,30,60,0.8); -fx-text-fill: white; -fx-border-color: #88aaff; -fx-border-radius: 5;" text="A EQUIPO" />
                        <Button fx:id="btnMoverCaja" mnemonicParsing="false" onAction="#accionMoverACaja" prefHeight="45.0" prefWidth="160.0" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10; -fx-background-color: rgba(20,30,60,0.8); -fx-text-fill: white; -fx-border-color: #88aaff; -fx-border-radius: 5;" text="A CAJA" />
                        <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#accionVolverMenu" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #ff4444; -fx-text-fill: white; -fx-font-family: 'Pokemon GB'; -fx-font-size: 10; -fx-border-color: #ffaaaa; -fx-border-radius: 5;" text="VOLVER" />
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Label style="-fx-font-family: 'Pokemon GB'; -fx-text-fill: white;" text="EQUIPO">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <ListView fx:id="listEquipo" onMouseClicked="#seleccionarDeEquipo" prefHeight="350.0" prefWidth="250.0" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10; -fx-background-color: transparent; -fx-control-inner-background: transparent;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER" prefHeight="260.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <Pane prefHeight="260.0" prefWidth="950.0" style="-fx-background-color: rgba(10, 15, 35, 0.85); -fx-background-radius: 20; -fx-border-color: #88aaff; -fx-border-width: 2; -fx-border-radius: 20;">
                    <children>
                        <ImageView fx:id="imgStatsFoto" fitHeight="160.0" fitWidth="160.0" layoutX="40.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox layoutX="230.0" layoutY="45.0" spacing="10.0">
                            <children>
                                <Label fx:id="lblStatsNombre" style="-fx-font-family: 'Pokemon GB';" text="NOMBRE" textFill="WHITE">
                                    <font>
                                        <Font size="20.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblStatsNivel" style="-fx-font-family: 'Pokemon GB';" text="NIVEL: --" textFill="#aaa">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblStatSexo" style="-fx-font-family: 'Pokemon GB';" text="-" textFill="WHITE">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <GridPane hgap="30.0" layoutX="480.0" layoutY="40.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="40.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="40.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="VITALIDAD" textFill="WHITE" />
                                <Label fx:id="lblStatVit" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="1" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="ATAQUE" textFill="WHITE" GridPane.rowIndex="1" />
                                <Label fx:id="lblStatAtq" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="DEFENSA" textFill="WHITE" GridPane.rowIndex="2" />
                                <Label fx:id="lblStatDef" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="ESTAMINA" textFill="WHITE" GridPane.rowIndex="3" />
                                <Label fx:id="lblStatEstamina" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="ATK. ESP" textFill="WHITE" GridPane.columnIndex="2" />
                                <Label fx:id="lblStatAtqEsp" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="3" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="DEF. ESP" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Label fx:id="lblStatDefEsp" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="VELOCIDAD" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <Label fx:id="lblStatVel" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                
                                <Label style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="EXP" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                <Label fx:id="lblStatExp" style="-fx-font-family: 'Pokemon GB'; -fx-font-size: 10;" text="0" textFill="#ffcc00" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                            </children>
                        </GridPane>
                    </children>
                </Pane>
            </children>
        </HBox>

        <ImageView id="botonSonido" fx:id="botonSonido" fitHeight="50.0" fitWidth="50.0" onMouseClicked="#mostrarBarraVolumen" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="40.0">
            <image>
                <Image url="@../img/Menu/volumenMax.png" />
            </image>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
            <effect>
                <DropShadow color="WHITE" radius="5.0" spread="0.7" />
            </effect>
        </ImageView>
        <Slider fx:id="sliderVolumen" max="1.0" onMouseExited="#ocultarSlider" orientation="VERTICAL" value="0.5" AnchorPane.bottomAnchor="90.0" AnchorPane.rightAnchor="55.0" />
    </children>
</AnchorPane>